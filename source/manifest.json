{
  "manifest_version": 3,
  "name": "GraBber V2",
  "version": "2.0.0",

  "icons": {
    "32": "assets/icons/favicon-32.png",
    "48": "assets/icons/favicon-48.png",
    "64": "assets/icons/favicon-64.png",
    "128": "assets/icons/favicon-128.png"
  },
  "description": "image grab",
  "short_name": "GraBber",

  "permissions": ["activeTab", "storage", "downloads"],

  "optional_permissions": [],

  "__chrome__host_permissions": [],

  "__chrome__optional_host_permissions": ["http://*/*", "https://*/*"],

  "__firefox__optional_host_permissions": ["http://*/*", "https://*/*"],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },

  "__chrome__minimum_chrome_version": "88",

  "action": {
    "default_popup": "Popup/popup.html",
    "default_icon": {
      "32": "assets/icons/favicon-32.png",
      "48": "assets/icons/favicon-48.png",
      "64": "assets/icons/favicon-64.png",
      "128": "assets/icons/favicon-128.png"
    },
    "default_title": "GraBber"
  },

  "__chrome__options_page": "Options/options.html",
  "options_ui": {
    "page": "Options/options.html",
    "open_in_tab": true
  },

  "background": {
    "__chrome__service_worker": "assets/js/background.bundle.js",
    "__chrome__type": "module",
    "__firefox__scripts": ["assets/js/background.bundle.js"],
    "__firefox__type": "module"
  },

  "content_scripts": [
    {
      "run_at": "document_idle",
      "matches": ["<all_urls>"],
      "css": [],
      "js": ["assets/js/contentScript.bundle.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
